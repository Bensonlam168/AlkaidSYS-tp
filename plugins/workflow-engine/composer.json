{
    "name": "alkaidsys/workflow-engine",
    "description": "AlkaidSYS Workflow Engine Plugin - 基于 Ingenious 改造",
    "type": "library",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "AlkaidSYS Team",
            "email": "team@alkaidsys.com"
        }
    ],
    "require": {
        "php": ">=8.2.0",
        "topthink/framework": "^8.0",
        "topthink/think-swoole": "^4.1",
        "php-di/php-di": "^7.0",
        "madong/helper": "^1.0",
        "symfony/expression-language": "^6.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^1.10",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Alkaid\\Workflow\\Engine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Alkaid\\Workflow\\Engine\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs-fix": "php-cs-fixer fix",
        "stan": "phpstan analyse"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
