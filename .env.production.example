# Production Environment Configuration for AlkaidSYS-tp
# 生产环境配置示例
#
# ⚠️ 重要提示 / Important Notes:
# 1. 本文件为生产环境配置模板，请复制为 .env 并根据实际环境调整
#    This file is a production configuration template, copy to .env and adjust for your environment
# 2. 所有敏感信息（密钥、密码等）必须通过安全渠道配置，禁止提交到版本控制
#    All sensitive information (secrets, passwords) MUST be configured via secure channels, DO NOT commit to version control
# 3. 生产环境必须使用 HTTPS 和强随机密钥
#    Production MUST use HTTPS and strong random keys

# Application Environment | 应用环境
# 生产环境必须设置为 production 或 prod
# Production environment MUST be set to production or prod
APP_ENV=production

# JWT Configuration | JWT 配置
# JWT issuer (iss) - 必须使用生产域名的完整 HTTPS URL
# JWT issuer (iss) - MUST use full HTTPS URL of production domain
JWT_ISSUER=https://api.alkaidsys.com

# JWT secret key - 必须使用强随机密钥（至少 32 字节）
# JWT secret key - MUST use strong random key (at least 32 bytes)
# 生成方法 / Generation method:
# - Linux/Mac: openssl rand -base64 32
# - PHP: base64_encode(random_bytes(32))
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_KEY_AT_LEAST_32_BYTES

# Cache & Redis Configuration | 缓存与 Redis 配置
# 生产环境强制使用 Redis
# Production environment forces Redis
CACHE_DRIVER=redis

# Redis 连接配置 / Redis connection configuration
# 请替换为实际的 Redis 服务器地址和密码
# Replace with actual Redis server address and password
REDIS_HOST=your-redis-server.internal.example.com
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
REDIS_DB=0

# Runtime DDL Guard | 运行时 DDL 保护
# 生产环境禁止运行时 DDL
# Production environment prohibits runtime DDL
SCHEMA_RUNTIME_DDL_ALLOWED_ENVS=
ALLOW_RUNTIME_DDL=false

# CORS Configuration | CORS 跨域配置
# ⚠️ 生产环境必须明确配置允许的域名
# ⚠️ Production MUST explicitly configure allowed domains
#
# 仅允许生产前端域名访问 API
# Only allow production frontend domains to access API
#
# 示例 / Example:
# - 主应用: https://app.alkaidsys.com
# - 管理后台: https://admin.alkaidsys.com
# - 移动端: https://m.alkaidsys.com
#
# 多域名用逗号分隔，不要有空格
# Multiple domains separated by comma, no spaces
CORS_ALLOWED_ORIGINS=https://app.alkaidsys.com,https://admin.alkaidsys.com

# Access Log Configuration | 访问日志配置
# 生产环境建议启用访问日志
# Production environment recommends enabling access log
ACCESS_LOG_ENABLED=true

# CORS Monitoring Configuration | CORS 监控配置
# 启用 CORS 拒绝日志记录
# Enable CORS rejection logging
CORS_REJECTION_LOG_ENABLED=true

# 当 CORS 拒绝率超过阈值时触发告警（可选，需配合监控系统）
# Trigger alert when CORS rejection rate exceeds threshold (optional, requires monitoring system)
# CORS_REJECTION_ALERT_THRESHOLD=0.1  # 10% rejection rate

# Database Configuration | 数据库配置
# 请根据实际生产数据库配置
# Configure according to actual production database
# DB_HOST=your-db-server.internal.example.com
# DB_PORT=3306
# DB_NAME=alkaidsys_production
# DB_USER=alkaidsys_app
# DB_PASS=REPLACE_WITH_STRONG_DB_PASSWORD

# Security Configuration | 安全配置
# 生产环境必须关闭调试模式
# Production MUST disable debug mode
APP_DEBUG=false

# Session Configuration | 会话配置
# 生产环境建议使用 Redis 存储会话
# Production recommends using Redis for session storage
# SESSION_DRIVER=redis

# Logging Configuration | 日志配置
# 生产环境日志级别建议设置为 error 或 warning
# Production log level should be set to error or warning
# LOG_LEVEL=error

# Rate Limiting Configuration | 限流配置
# 根据实际业务需求调整限流参数
# Adjust rate limiting parameters according to actual business needs
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_MAX_REQUESTS=100
# RATE_LIMIT_WINDOW_SECONDS=60

# Monitoring & Observability | 监控与可观测性
# 配置监控系统的相关参数（如 APM、日志采集等）
# Configure monitoring system parameters (e.g., APM, log collection)
# APM_ENABLED=true
# APM_SERVICE_NAME=alkaidsys-api
# APM_SERVER_URL=https://apm.example.com

# Backup & Disaster Recovery | 备份与容灾
# 配置备份策略和容灾参数
# Configure backup strategy and disaster recovery parameters
# BACKUP_ENABLED=true
# BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM

