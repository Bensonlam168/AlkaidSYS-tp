# -----------------------------------------------------------------------------
# AlkaidSYS 生产环境配置模板 / Production environment template
#
# 用法 Usage:
#   复制为 .env.production 并按实际环境逐项替换占位符
#     cp .env.production.example .env.production
#   .env.production 已被 .gitignore 的 `.env.*` 规则排除，绝不入库；
#   它是 docker-compose.prod.yml 的 env_file，注入到后端容器的环境变量里。
#
# 本文件的硬性约束 Hard rules for comments
#
#   1. 注释行禁止出现半角括号与引号：
#      think\Env::load 的实现是 parse_ini_file 失败即按空数组兜底，
#      而 # 注释行同样会参与 INI 词法分析 —— 注释里出现半角括号或引号，
#      整份文件就会解析失败，结果是所有键静默失效，
#      表现为「进程正常启动，但连不上库 / 鉴权全挂」。需要括号请用全角括号。
#   2. 注释行禁止出现半角等号：
#      它会被解析成伪键，键名形如「# 1. 生产环境」，既污染配置数组，
#      也让真实键名难以辨认。表达「取值」请直接用文字描述。
#   3. 注释行禁止出现半角竖线、与号、美元符号：
#      这三个字符参与 INI 词法分析，会让 parse_ini_file 直接报语法错误。分隔线请用短横线。
#
#   以上规则由 php scripts/check-env-example.php --strict 的检查 E 守护，
#   对应的 CI 门禁为 Env Example Consistency。
#
# 分组顺序刻意与 .env.example 对齐，便于逐键对照。
# -----------------------------------------------------------------------------

# ---------------------------- 应用 Application ----------------------------
# 生产必须取值为 production 或 prod。它决定多处行为：
#   - config/cache.php 在 production / prod / stage / staging 下强制使用 redis 驱动；
#   - app\controller\Index 与 app\middleware\Cors 等据此切换生产策略；
#   - app\ExceptionHandle 据此只对外暴露通用错误文案。
# 不配会怎样：多个模块的缺省值并不一致，例如 config/cache.php 缺省按 production 处理，
#   而 app\middleware\RateLimit 缺省按 dev 处理 —— 只有显式写出，行为才可预期。
APP_ENV=production

# 生产必须 false。
# 不配会怎样：config/database.php 的 trigger_sql 缺省取值为 true，会把每条 SQL 打进日志；
#   config/swoole.php 的热重载也据它判断，生产开着既多开销又会泄露实现细节。
APP_DEBUG=false

# ---------------------------- 数据库 Database ----------------------------
# 这一组最危险：config/database.php 为本地开发准备的缺省值是
#   DB_HOST 缺省 127.0.0.1、DB_USER 缺省 root、DB_PASS 缺省空字符串、DB_NAME 缺省空字符串。
#   也就是说，少配 DB_USER 与 DB_PASS，生产就会以 root 且空口令连库。
#
# 每个键不配会怎样：
#   DB_TYPE    —— 缺省取值为 mysql，通常与这里一致；显式写出是为了让引擎可审计。
#   DB_HOST    —— 缺省取值为 127.0.0.1，在容器内指向容器自身，所有数据库操作 Connection refused。
#   DB_NAME    —— 缺省取值为空字符串，等于没有选库，任何查询都会失败。
#   DB_USER    —— 缺省取值为 root，用最高权限账号连库，违反最小权限原则。
#   DB_PASS    —— 缺省取值为空字符串，即无口令连库。
#   DB_PORT    —— 缺省取值为 3306，通常与这里一致。
#   DB_CHARSET —— 缺省取值为 utf8mb4；必须保持 utf8mb4，
#                 因为 utf8 即 utf8mb3，存不了 emoji 与部分 CJK 字形，
#                 写入会报 1366 Incorrect string value，或被静默截断。
DB_TYPE=mysql
DB_HOST=your-mysql-server.internal.example.com
DB_NAME=REPLACE_WITH_PRODUCTION_DB_NAME
DB_USER=REPLACE_WITH_PRODUCTION_DB_USER
DB_PASS=REPLACE_WITH_STRONG_DB_PASSWORD
DB_PORT=3306
DB_CHARSET=utf8mb4

# ---------------------------- 默认语言 Locale ----------------------------
# 允许值见 config/lang.php 的 allow_lang_list，当前为 zh-cn 与 en-us。
# 不配会怎样：缺省取值为 zh-cn，与本行一致；显式写出可避免未来默认值变更
#   悄悄改变接口文案与校验消息的语言。
DEFAULT_LANG=zh-cn

# ---------------------------- 鉴权 JWT ----------------------------
# JWT 签发者，会写进 token 的 iss 声明，必须是生产域名的完整 HTTPS URL。
# 不配会怎样：缺省取值为 https://api.alkaidsys.local，与生产域名不符，
#   跨服务校验 token 的 iss 时会失败。
JWT_ISSUER=https://api.alkaidsys.com

# JWT 签名密钥，必须足够长的随机值，至少 32 字节。生成方式：openssl rand -hex 32
# 不配会怎样：缺省取值为一个仓库内公开的占位字符串，
#   JwtService 在生产类环境构造时直接抛异常 —— 由于它是惰性构造的，
#   进程不会启动失败，而是「进程起来了，之后每个需要鉴权的请求失败」。
# 注意：本行保留的 REPLACE_WITH 前缀同样被 JwtService 判定为公开占位符，
#   未替换即等同于未配置，必须换成真实随机值后才能上线。
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_KEY_AT_LEAST_32_BYTES

# ---------------------------- 多租户 Multi-tenant ----------------------------
# 请求未携带 X-Tenant-ID 时使用的默认租户 ID，
# 是 app\middleware\TenantIdentify 的 fail-closed 依据，也是全项目唯一的默认租户决定点。
#
# 必须改成真实存在的租户 id。这里的占位值刻意不是数字：
#   租户中间件对「未配置」与「非正整数」一律抛 TenantContextMissingException，
#   因此忘记替换时的行为是「进程照常启动、每个请求 500」—— 立刻可见，不会被忽略。
#   反过来，若图省事直接填 1 而不核对，看似能跑，实际却把所有不带 X-Tenant-ID 的请求
#   静默归到租户 1，属于把部署错误变成数据归属错误，比 500 更难发现。
#
# 不配会怎样：所有不带 X-Tenant-ID 的请求，包括登录与 /healthz 健康探针，全部返回 500 与业务码 5000；
#   由于 TenantIdentify 是全局中间件，容器健康检查永远失败，编排层会反复重启实例。
#   排障入口：日志里的 TENANT_CONTEXT_MISSING_CONFIG 记录（生产环境对外只给通用文案，细节只进日志）。
DEFAULT_TENANT_ID=REPLACE_WITH_REAL_TENANT_ID

# 自助注册的目标租户 ID。
# 留空即关闭自助注册，注册接口返回 403 与业务码 2008。
# 若某租户的 tenants.domain 与请求 Host 匹配，则优先使用该租户，忽略本配置。
# 安全提示：注册目标租户不会从客户端 X-Tenant-ID 读取。
# 不配会怎样：与留空一致 —— 自助注册关闭，这是生产建议的默认状态。
REGISTRATION_TENANT_ID=

# ---------------------- 限流：可信反向代理名单 Rate limit ----------------------
# 仅在应用层限流开启时被消费，见 config/ratelimit.php 的 enabled。
#
# 取值：逗号分隔，支持单个 IP 与 CIDR，IPv4 与 IPv6 均可，不要带空格。
# 示例：单个地址 10.0.0.10；多个地址 10.0.0.10,10.0.0.11；网段 10.0.0.0/24。
# 只填你自己的反向代理或负载均衡地址，绝不要填客户端可达的地址段。
#
# 为什么需要它：限流的 ip 维度需要客户端真实 IP，而真实 IP 只能从 X-Forwarded-For 读出来，
#   这个请求头客户端可以随意伪造，因此只有 TCP 对端属于可信代理时才允许采信。
#   留空的含义是「不信任任何 XFF」，一律使用 TCP 对端地址。
#
# 不配会怎样：若生产经过反向代理且开启了限流，所有请求的 TCP 对端都是同一个代理地址，
#   全站共用一个 ip 限流桶 —— 稍有流量就整体返回 429，且无法按真实客户端分流。
#   反之若填成过大的网段，等于把伪造 IP 的能力交回客户端，所以宁缺毋滥。
TRUSTED_PROXIES=

# ---------------- 事件系统：监听器失败严格模式 Event system ----------------
# 生产必须 false。缺省 false 时监听器异常只记一条结构化 error 日志，
# 日志键为 event.listener.failed，主流程仍拿到正常 payload；
# 设为 true 则监听器异常原样上抛，等于把「插件写错」升级成业务 500。
# 不配会怎样：config/event.php 的缺省值就是 false，行为与本行一致；
#   显式写出是为了防止未来默认值变更把生产带偏。
EVENT_FAIL_FAST=false

# ---------------------------- 缓存 Cache 与 Redis ----------------------------
# config/cache.php：APP_ENV 取值为 production / prod / stage / staging 时强制使用 redis 驱动。
# 不配会怎样：生产没有任何影响，因为驱动已被 APP_ENV 强制为 redis；
#   非生产环境缺省回落到 file。
CACHE_DRIVER=redis

# Redis 连接。生产若使用外部或云 Redis，必须改成实际地址。
# 不配会怎样：
#   REDIS_HOST     —— 缺省取值为 redis，只在 docker compose 的同名服务网络里解析得到。
#   REDIS_PORT     —— 缺省取值为 6379。
#   REDIS_PASSWORD —— 缺省取值为空字符串，即无口令连接；开启 AUTH 的实例会直接连不上。
#   REDIS_DB       —— 缺省取值为 0；与其它系统共用实例时应换库号做隔离。
# 缓存与会话都在 Redis 上，配错的典型表现是「登录成功但随即 401」以及健康探针 500。
REDIS_HOST=your-redis-server.internal.example.com
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
REDIS_DB=0

# ---------------------- 运行时 DDL 保护 Runtime DDL Guard ----------------------
# 生产禁止应用在运行期建表改表。
# 不配会怎样：infrastructure\Schema\SchemaBuilder 的缺省允许名单是 dev,local,testing，
#   且 ALLOW_RUNTIME_DDL 缺省为 false，因此生产默认已是「禁止」；
#   这里显式写出空名单与 false，是为了让「生产永远不允许运行时 DDL」成为仓库内的显式事实，
#   而不是依赖某处默认值。
SCHEMA_RUNTIME_DDL_ALLOWED_ENVS=
ALLOW_RUNTIME_DDL=false

# ---------------------------- 跨域 CORS ----------------------------
# 生产必须显式配置允许的域名，多域名用逗号分隔且不要带空格。
# 示例：https://app.example.com,https://admin.example.com,https://m.example.com
# 不配会怎样：app\middleware\Cors 在 CORS_ALLOWED_ORIGINS 为空时会退回 localhost 默认源并记 warning，
#   前端生产域名的跨域请求会被拒绝 —— 表现为浏览器侧全部失败，服务端只剩 CORS 拒绝记录。
CORS_ALLOWED_ORIGINS=https://app.alkaidsys.com,https://admin.alkaidsys.com

# 记录被拒绝的跨域请求，便于排查上面那类问题。
# 不配会怎样：代码缺省为开启，与本行一致，被拒的请求仍会留下日志。
# 注意：该开关的实现是对取值做布尔强转，字符串形式的 false 同样会被判定为开启；
#   要真正关闭必须改实现，而不是把它写成 false —— 这一点已登记为遗留风险。
CORS_REJECTION_LOG_ENABLED=true

# ---------------------------- 访问日志 Access Log ----------------------------
# 生产建议开启，app\middleware\AccessLog 会把每次请求连同 trace_id 写入日志。
# 不配会怎样：缺省关闭时没有任何访问日志，线上排障只能依赖 nginx 访问日志。
ACCESS_LOG_ENABLED=true

# ---------------------------- 本模板未覆盖的项 Not covered here ----------------------------
# 下面这些键刻意不在本模板内，新增前请先确认代码是否真的读取：
#
# 1. 代码确实读取、但属于「按需调优」的项，保持缺省即可：
#    - 限流：config/ratelimit.php 的 RATELIMIT_* 系列。
#      注意键名里 RATE 与 LIMIT 之间没有下划线；旧版模板里写的 RATE_LIMIT_ENABLED
#      等键名在当前代码里完全不会被读取，请勿沿用。
#    - 权限：config/casbin.php 的 CASBIN_* 系列。
# 2. 代码当前完全不读取，写了也不会生效，因此不再列出示例值：
#    - SESSION_DRIVER：会话驱动由 config/session.php 硬编码为 cache 驱动加 redis 存储。
#    - LOG_LEVEL：日志级别不从环境变量读取，见 config/log.php。
#    - CORS_REJECTION_ALERT_THRESHOLD：仓库内没有读取它的实现，拒绝率告警需在监控侧做。
#    - APM_* 与 BACKUP_*：仓库内没有对应的读取实现。
#
# 另有一组凭据不属于本文件：docker-compose.prod.yml 用冒号问号的必填语法强制要求
#   MYSQL_ROOT_PASSWORD、MYSQL_USER、MYSQL_PASSWORD、RABBITMQ_DEFAULT_USER、RABBITMQ_DEFAULT_PASS。
#   这些是 compose 的插值变量，只会从 shell 环境或 compose 的项目级 .env 读取；
#   写进 .env.production 不会满足它们，因为 .env.production 是容器的 env_file。
