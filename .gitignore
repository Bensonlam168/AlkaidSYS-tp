# ============================================================================
# .gitignore —— 仓库根忽略规则
#
# 维护约定：
#   1. 同一模式只保留一条；
#   2. 两条只差尾斜杠（如 /vendor/ 与 /vendor），或一条包含另一条时，
#      保留范围更广的那条。/vendor 匹配「根下一个叫 vendor 的条目（文件或目录）」，
#      /vendor/ 只匹配目录；留窄的会让「根下一个叫 vendor 的文件」从被忽略变回不被忽略；
#      同理，不带前导 / 的 .phpunit.result.cache 匹配任意层级，包含 /.phpunit.result.cache（仅根）；
#   3. 修改本文件后必须跑一次路径矩阵比对，确认任何路径的忽略状态都没变。
# ============================================================================

# ---------------------------------------------------------------------------
# 依赖与构建产物
# ---------------------------------------------------------------------------
/vendor
/node_modules/
/frontend/node_modules/
/frontend/dist/
/frontend/.turbo/
/frontend/.cache/
composer.phar

# ---------------------------------------------------------------------------
# 环境文件
# 注意：下方 ! 例外必须排在 .env 与 .env.* 之后，顺序颠倒例外即失效，
#       两个模板会从库里消失。
# ---------------------------------------------------------------------------
.env
.env.*
# 例外：以下 env 模板文件必须入库（不含真实密钥，仅占位符）
!.env.example
!.env.production.example

# ---------------------------------------------------------------------------
# IDE 与系统
# ---------------------------------------------------------------------------
/.idea
/.vscode
.DS_Store
Thumbs.db

# ---------------------------------------------------------------------------
# 其他编辑器 / 工具开关
# 下方以 # 开头的行是刻意关闭的开关，保留以示「这里曾经考虑过忽略」，请勿删除。
# ---------------------------------------------------------------------------
# /.settings
/.buildpath
# /.project
# Serena MCP
# /.serena
# Augment
# /.augment
# zed
/.zed

# ---------------------------------------------------------------------------
# 日志与运行时
# ---------------------------------------------------------------------------
/runtime
/tmp/
/storage/
/logs/
*.log

# ---------------------------------------------------------------------------
# 缓存文件
# ---------------------------------------------------------------------------
# Serena 工具缓存（体积大，不入库）
/.serena/cache/

.php-cs-fixer.cache
.phpunit.cache
# PHPUnit 结果缓存
# 原 /.phpunit.result.cache 只锚定仓库根，已被下方这条同名规则（匹配任意层级）包含
.phpunit.result.cache

# ---------------------------------------------------------------------------
# 临时脚本与调试产物
# ---------------------------------------------------------------------------
# 临时分析脚本
analyze_*.py
debug_*.py
generate_*.py
refine_*.py
split_*.py

# 临时 HTML 文件
error_*.html
public/debug_*.html
public/debug_*.svg

# 生成的图片文件
public/generated_image_*.png

# ---------------------------------------------------------------------------
# 测试覆盖率
# ---------------------------------------------------------------------------
# 覆盖率报告产物（可再生，不入库）
# 刻意不带前导 /：这样同时覆盖仓库根 coverage/（php think test --coverage-html=coverage/）
# 与 frontend/coverage/（pnpm / vitest 的覆盖率输出目录），避免只挡住其中一边
coverage/

# ---------------------------------------------------------------------------
# 本地专有文件
# ---------------------------------------------------------------------------
# 开发工具配置
.git-commit-message*.txt
README.local-merge-backup.md

# 本地容器端口冲突 override（不入库）
docker-compose.override.local.yml

# ---------------------------------------------------------------------------
# 工具产物
# ---------------------------------------------------------------------------
.openbitfun/

# SDD 工作区（superpowers subagent-driven-development 的临时产物）
.superpowers/

# Graphify 知识图谱产物（可再生，不入库）
graphify-out/

# ---------------------------------------------------------------------------
# 文档目录
# 下方以 # 开头的行是刻意关闭的开关，保留以示「这里曾经考虑过忽略」，请勿删除。
# ---------------------------------------------------------------------------
# # dev-docs
# /docs/mcp_docs
# /docs/other-docs
# /docs/report
# /docs/report_archive
# /docs/todo
/docs/Example
# # design
# /design
