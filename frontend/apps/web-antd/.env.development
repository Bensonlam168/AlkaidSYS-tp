# 端口号
VITE_PORT=5666

VITE_BASE=/

# 接口地址 - Backend API address
# 在 Docker 开发环境中，通过 alkaid-nginx 网关暴露在宿主机 80 端口，
# 统一使用 http://localhost 作为 API 根路径，具体版本前缀由后端路由控制（/v1/...）。
VITE_GLOB_API_URL=http://localhost

# 是否开启 Nitro Mock服务，true 为开启，false 为关闭
# Disable mock for real backend API
VITE_NITRO_MOCK=false

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true
