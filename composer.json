{
    "name": "alkaidsys/alkaidsys",
    "description": "AlkaidSYS（瑶光系统）：强大、现代、低代码的企业级 SaaS 系统框架，基于 ThinkPHP 8 + Swoole + Vue 3",
    "type": "project",
    "keywords": [
        "alkaidsys",
        "lowcode",
        "saas",
        "thinkphp",
        "swoole",
        "multi-tenant"
    ],
    "homepage": "https://github.com/Bensonlam168/AlkaidSYS-tp",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "AlkaidSYS",
            "homepage": "https://github.com/Bensonlam168/AlkaidSYS-tp"
        }
    ],
    "require": {
        "php": ">=8.2.0",
        "topthink/framework": "^8.0",
        "topthink/think-orm": "^3.0|^4.0",
        "topthink/think-filesystem": "^2.0|^3.0",
        "topthink/think-swoole": "^4.1",
        "topthink/think-queue": "^3.0",
        "firebase/php-jwt": "^6.11",
        "ramsey/uuid": "^4.9",
        "nesbot/carbon": "^3.10",
        "guzzlehttp/guzzle": "^7.10",
        "league/flysystem": "^3.30",
        "predis/predis": "^3.2",
        "php-amqplib/php-amqplib": "^3.7",
        "symfony/validator": "^7.3",
        "symfony/serializer": "^7.3",
        "monolog/monolog": "^3.9",
        "topthink/think-migration": "^3.1",
        "casbin/casbin": "^3.0"
    },
    "require-dev": {
        "topthink/think-dumper": "^1.0",
        "topthink/think-trace": "^2.0",
        "phpunit/phpunit": "^11.5",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.89",
        "fakerphp/faker": "^1.24",
        "symfony/yaml": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "app\\": "app",
            "Domain\\": "domain",
            "Infrastructure\\": "infrastructure",
            "Alkaid\\Workflow\\Engine\\": "plugins/workflow-engine/src/",
            "plugin\\": "addons/plugins/"
        },
        "psr-0": {
            "": "extend/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Alkaid\\Workflow\\Engine\\Tests\\": "plugins/workflow-engine/tests/"
        }
    },
    "config": {
        "preferred-install": "dist",
        "audit": {
            "block-insecure": true,
            "ignore": {
                "PKSA-y2cr-5h3j-g3ys": "firebase/php-jwt <7.0.0 弱密钥；唯一修复 7.0.0 强制 HS256 密钥 >=32 字节，会打断当前 .env 与测试密钥，暂留 6.11（详见 extra.audit-rationale）"
            }
        }
    },
    "extra": {
        "audit-rationale": {
            "PKSA-y2cr-5h3j-g3ys": "firebase/php-jwt < 7.0.0（PHP-JWT 密钥长度未校验 / 弱加密，low）。唯一修复版本 7.0.0 是破坏性 major：它强制 HS256 密钥长度 >= 32 字节（实测 16 字节与 25 字节密钥在 encode/decode 时抛 DomainException: Provided key is too short）。本仓库当前 .env 的 JWT_SECRET 为 CHANGE_THIS_IN_PRODUCTION（25 字节），tests/Unit/Auth/JwtServiceTest 使用 unit_test_secret（16 字节），升级会直接打断鉴权链路与测试。生产环境已由 Infrastructure\\Auth\\JwtService::assertProductionSecretIsSecure 强制 >= 32 字节且拒绝公开占位符，因此本公告在生产不可利用（影响面仅限 dev/test 的弱密钥）。处置：暂留 6.11，待轮换 .env 密钥并同步测试密钥后再升级到 ^7.0，届时必须删除本条 ignore。"
        },
        "audit-review-by": {
            "PKSA-y2cr-5h3j-g3ys": "2027-03-31"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php think service:discover",
            "@php think vendor:publish"
        ]
    }
}
