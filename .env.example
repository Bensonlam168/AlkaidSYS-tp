APP_DEBUG = true

# Database
# 数据库连接（配错会导致「容器正常启动但连不上库」，请先读完这段注释）：
#
# 1. 下面的值是 **docker compose 本地开发默认值**，与 docker-compose.yml 的 mysql 服务一致：
#    镜像 mysql:8.0、服务名 mysql、库名 alkaid_sys、账号 root / root。
#    全新检出后执行 cp .env.example .env 即可直接连上 compose 里的数据库。
#
# 2. 生产部署必须替换：DB_HOST 改成实际数据库主机，DB_PASS 改成强密码。
#    root / root 属于公开的 dev 默认值，绝不可用于生产。
#    compose 另建了业务账号 alkaid / alkaid123，见 MYSQL_USER，需要最小权限时可改用；
#    但该账号只在数据卷首次初始化时创建，旧数据卷上可能不存在，故默认仍用 root。
#
# 3. **.env 的优先级高于容器环境变量**：think\Env 的 get 方法先读 .env 填充的数据，
#    缺失时才回落 PHP 进程环境变量与 getenv，所以这里写错会覆盖 docker compose 为容器注入的
#    DB_HOST 值 mysql，表现为「容器起来了，但所有数据库操作 Connection refused」。
#    容器内的 127.0.0.1 指向容器自身而不是 mysql 容器，因此不要写 127.0.0.1。
#
# 4. DB_CHARSET 必须是 utf8mb4：utf8 即 utf8mb3，存不了 emoji 与部分 CJK 如 𠮷 😀，
#    写入会报 1366 Incorrect string value，或被静默截断。
DB_TYPE = mysql
DB_HOST = mysql
DB_NAME = alkaid_sys
DB_USER = root
DB_PASS = root
DB_PORT = 3306
DB_CHARSET = utf8mb4

DEFAULT_LANG = zh-cn

# Security
# JWT 签名密钥（请务必阅读，配错会导致「登录成功但所有受保护接口 401/500」）：
#
# 1. 生产类环境（APP_ENV = production / prod / stage / staging，或未设置 APP_ENV）：
#    必须替换为足够长的随机密钥（≥ 32 字节，例如 `openssl rand -hex 32`）。
#    留空、沿用公开占位符（CHANGE_THIS_IN_PRODUCTION、REPLACE_WITH*、dev-only-*）或长度不足时，
#    JwtService 构造即抛异常 → 鉴权请求被拒绝；由于 JwtService 是惰性构造的，
#    **进程不会在启动期失败**，而是「进程正常启动，之后每个需要鉴权的请求失败」。
#
# 2. 非生产环境（APP_ENV = dev / local / testing）：
#    允许留空 —— 但**不要**真的留空：空密钥会被回退到内置开发密钥并记录 warning。
#    原因：firebase/php-jwt 拒绝空 key 解码，真空密钥会「签发成功但校验失败」，
#    表现为登录返回 200 带 token、随后每个受保护接口 401，极难定位。
#
# 3. 下面的值仅是 **dev 专用占位值**（属于公开字符串，生产环境会被拒绝），生产部署必须替换。
#    注意：docker compose 已为后端容器设置 APP_ENV=dev；若在容器外直接运行，请自行设置 APP_ENV=dev。
JWT_SECRET = dev-only-insecure-secret-please-change-in-production-0123456789
JWT_ISSUER = https://api.alkaidsys.local

# Multi-tenant
# 未显式提供 X-Tenant-ID 时使用的默认租户 ID（单租户部署可保持 1）
DEFAULT_TENANT_ID = 1
# 自助注册的目标租户 ID。
# 留空 = 关闭自助注册（注册接口返回 403 / code 2008）。
# 若某租户的 tenants.domain 与请求 Host 匹配，则优先使用该租户，忽略此配置。
# 安全提示：注册目标租户**不会**从客户端 X-Tenant-ID 读取。
REGISTRATION_TENANT_ID =
