APP_DEBUG = true

# Database
# 数据库连接（配错会导致「容器正常启动但连不上库」，请先读完这段注释）：
#
# 1. 下面的值是 **docker compose 本地开发默认值**，与 docker-compose.yml 的 mysql 服务一致：
#    镜像 mysql:8.0、服务名 mysql、库名 alkaid_sys、账号 root / root。
#    全新检出后执行 cp .env.example .env 即可直接连上 compose 里的数据库。
#
# 2. 生产部署必须替换：DB_HOST 改成实际数据库主机，DB_PASS 改成强密码。
#    root / root 属于公开的 dev 默认值，绝不可用于生产。
#    compose 另建了业务账号 alkaid / alkaid123，见 MYSQL_USER，需要最小权限时可改用；
#    但该账号只在数据卷首次初始化时创建，旧数据卷上可能不存在，故默认仍用 root。
#
# 3. **.env 的优先级高于容器环境变量**：think\Env 的 get 方法先读 .env 填充的数据，
#    缺失时才回落 PHP 进程环境变量与 getenv，所以这里写错会覆盖 docker compose 为容器注入的
#    DB_HOST 值 mysql，表现为「容器起来了，但所有数据库操作 Connection refused」。
#    容器内的 127.0.0.1 指向容器自身而不是 mysql 容器，因此不要写 127.0.0.1。
#
# 4. DB_CHARSET 必须是 utf8mb4：utf8 即 utf8mb3，存不了 emoji 与部分 CJK 如 𠮷 😀，
#    写入会报 1366 Incorrect string value，或被静默截断。
DB_TYPE = mysql
DB_HOST = mysql
DB_NAME = alkaid_sys
DB_USER = root
DB_PASS = root
DB_PORT = 3306
DB_CHARSET = utf8mb4

DEFAULT_LANG = zh-cn

# Security
# JWT 签名密钥（请务必阅读，配错会导致「登录成功但所有受保护接口 401/500」）：
#
# 1. 生产类环境（APP_ENV 取值为 production / prod / stage / staging，或未设置 APP_ENV）：
#    必须替换为足够长的随机密钥（≥ 32 字节，例如 `openssl rand -hex 32`）。
#    留空、沿用公开占位符（CHANGE_THIS_IN_PRODUCTION、REPLACE_WITH*、dev-only-*）或长度不足时，
#    JwtService 构造即抛异常 → 鉴权请求被拒绝；由于 JwtService 是惰性构造的，
#    **进程不会在启动期失败**，而是「进程正常启动，之后每个需要鉴权的请求失败」。
#
# 2. 非生产环境（APP_ENV 取值为 dev / local / testing）：
#    允许留空 —— 但**不要**真的留空：空密钥会被回退到内置开发密钥并记录 warning。
#    原因：firebase/php-jwt 拒绝空 key 解码，真空密钥会「签发成功但校验失败」，
#    表现为登录返回 200 带 token、随后每个受保护接口 401，极难定位。
#
# 3. 下面的值仅是 **dev 专用占位值**（属于公开字符串，生产环境会被拒绝），生产部署必须替换。
#    注意：docker compose 已为后端容器设置 APP_ENV 为 dev；若在容器外直接运行，请自行设置 APP_ENV 为 dev。
JWT_SECRET = dev-only-insecure-secret-please-change-in-production-0123456789
JWT_ISSUER = https://api.alkaidsys.local

# Multi-tenant
# 未显式提供 X-Tenant-ID 时使用的默认租户 ID（单租户部署可保持 1）
DEFAULT_TENANT_ID = 1
# 自助注册的目标租户 ID。
# 留空即关闭自助注册（注册接口返回 403 / code 2008）。
# 若某租户的 tenants.domain 与请求 Host 匹配，则优先使用该租户，忽略此配置。
# 安全提示：注册目标租户**不会**从客户端 X-Tenant-ID 读取。
REGISTRATION_TENANT_ID =

# Rate limit / 限流：可信反向代理名单
# 仅当应用层限流开启时才会被消费，见 config/ratelimit.php 的 enabled。
#
# 作用：限流的 ip 维度需要「客户端真实 IP」，而真实 IP 只能从 X-Forwarded-For 读出来，
# 这个请求头**客户端可以随便伪造**。所以只有「TCP 对端一定是自己的反向代理」时才允许采信它。
#
# 取值：逗号分隔，支持单个 IP 与 CIDR，IPv4 / IPv6 均可。默认留空，即**不信任任何 XFF**，
# 一律使用 TCP 对端地址。这个默认值只牺牲「按真实客户端分流」，不会带来伪造风险，
# 因此留空是安全的；反之若填错成一个大网段，就等于把伪造能力交回给客户端。
#
# 本仓库 docker compose 场景的可直接使用示例：
#   1. 先查 nginx 容器在 compose 网络中的地址，在宿主机执行
#      docker network inspect alkaidsys-tp_default
#      在输出的 Containers 段里找到 alkaid-nginx 对应的 IPv4Address。
#   2. 当前实测值为 172.18.0.6，compose 网络为 172.18.0.0/16，网关为 172.18.0.1
#   3. 因此这里填 172.18.0.6 即可；也可填网段 172.18.0.0/16，但**不建议**：
#      backend 的 9501 端口发布了到宿主机，直连该端口的请求对端是 docker 网关 172.18.0.1，
#      信任整个网段会让这条绕过 nginx 的路径上的 XFF 重新变成可伪造。
#   4. 容器重建后 IP 可能变化，行为退化为「不信任 XFF」（安全方向），届时按第 1 步重新取值。
#
# 生产部署：只填真实反向代理 / 负载均衡器的地址，不要填客户端可达的地址段。
TRUSTED_PROXIES = 172.18.0.6

# Seed data / 初始种子数据
# 首次执行 php think seed:run 之前必须先设置环境变量 ADMIN_INIT_PASSWORD，
# 否则种子会**明确报错并退出**，不会创建任何管理员账号。
#
# 1. 本文件刻意不给该变量写键值行，需要你自己在 .env 里新增一行：
#    键名为 ADMIN_INIT_PASSWORD，值为 admin 账号的初始登录口令。
#    不预置默认值的原因：默认口令一旦进了仓库，等于对全网公开的后门。
# 2. 它只在 seed:run 需要**新建**管理员账号时才会被读取。
#    已经种过数据的库重跑 seed:run 不要求它，也不会修改既有管理员的口令。
# 3. 该口令仅用于初始化，生产部署请使用强口令，并在首次登录后立即修改。
