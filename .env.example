APP_DEBUG = true

DB_TYPE = mysql
DB_HOST = 127.0.0.1
DB_NAME = test
DB_USER = username
DB_PASS = password
DB_PORT = 3306
DB_CHARSET = utf8

DEFAULT_LANG = zh-cn

# Security
JWT_SECRET = CHANGE_THIS_IN_PRODUCTION
JWT_ISSUER = https://api.alkaidsys.local

# Multi-tenant
# 未显式提供 X-Tenant-ID 时使用的默认租户 ID（单租户部署可保持 1）
DEFAULT_TENANT_ID = 1
# 自助注册的目标租户 ID。
# 留空 = 关闭自助注册（注册接口返回 403 / code 2008）。
# 若某租户的 tenants.domain 与请求 Host 匹配，则优先使用该租户，忽略此配置。
# 安全提示：注册目标租户**不会**从客户端 X-Tenant-ID 读取。
REGISTRATION_TENANT_ID =
